---
import Pagination from "../components/control/Pagination.astro";
import PostPage from "../components/PostPage.astro";
import { PAGE_SIZE } from "../constants/constants";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { getSortedPosts } from "../utils/content-utils";
import { url } from "../utils/url-utils";

export const prerender = false;

const pageNum = Number.parseInt(Astro.params.page || "1", 10);
const allPosts = await getSortedPosts();

const total = allPosts.length;
const totalPages = Math.ceil(total / PAGE_SIZE);
const safePage = Math.min(Math.max(1, pageNum), totalPages);
const start = (safePage - 1) * PAGE_SIZE;
const end = start + PAGE_SIZE;
const pagePosts = allPosts.slice(start, end);

const page = {
	data: pagePosts,
	currentPage: safePage,
	lastPage: totalPages,
	total,
	url: {
		prev: safePage > 1 ? url(`/${safePage - 1 === 1 ? "" : `${safePage - 1}/`}`) : undefined,
		next: safePage < totalPages ? url(`/${safePage + 1}/`) : undefined,
	},
};

const len = page.data.length;
---
<MainGridLayout>
    <PostPage page={page}></PostPage>
    <Pagination class="mx-auto onload-animation" page={page} style={`animation-delay: calc(var(--content-delay) + ${(len)*50}ms)`}></Pagination>
</MainGridLayout>
